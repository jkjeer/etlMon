<%@ Master Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="SSIS.master.cs" Inherits="etlMon.SSIS" EnableViewState="true" %>
<%@ MasterType VirtualPath="Site.Master" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
        <table class="layout">
            <tr>
                <td valign="top">
                    <asp:DropDownList ID="selPackage" runat="server" OnSelectedIndexChanged="fnPackageChanged" AutoPostBack="true" EnableViewState="true">
                    </asp:DropDownList>
                    <asp:CompareValidator ID="CVPackageID" ControlToValidate="selPackage" runat="server" 
                        Operator="GreaterThan" ValueToCompare="0"
                        CssClass="disabled" ErrorMessage="Please select a Package">
                    </asp:CompareValidator>                        
                </td>
            </tr>
            <tr>
                <td valign="top">
                    <span class="btnleft"><asp:Button id="btnSchedule" Runat="server" Text="Schedule" Width="100" onClick="btnSchedule_Click" /></span>
                    <span class="btnleft"><asp:Button id="btnConfig" Runat="server" Text="Config" Width="100" onClick="btnConfiguration_Click" /></span>
                    <span class="btnleft"><asp:Button id="btnLogs" Runat="server" Text="Logs" Width="100" onClick="btnLogs_Click" /></span>
                </td>
            </tr>
            <tr>
                <td valign="top">
                    <span class="btnleft"><asp:Button id="btnAgentHist" Runat="server" Text="History" Width="100" onClick="btnHistory_Click" /></span>
                </td>
            </tr>
        </table>
        <div id="mainContent">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
</asp:Content> 